# Copy to .env; never commit secrets.
MEDIA_ROOT=D:/Docker
DOMAIN=example.com
TZ=Europe/London
PUID=1000
PGID=1000
VPN_COUNTRY=United Kingdom
# Paid Proton VPN WireGuard private key. Never put this in git.
PROTON_WIREGUARD_PRIVATE_KEY=REPLACE_ME

# Required only when starting the optional roles profile:
SEERR_API_KEY=REPLACE_ME
ROLE_MANAGER_PASSWORD=REPLACE_WITH_UNIQUE_STRONG_PASSWORD
ROLE_MANAGER_SESSION_SECRET=REPLACE_WITH_RANDOM_HEX
